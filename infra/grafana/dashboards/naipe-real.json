{
  "uid": "naipe-real",
  "title": "Naipe Real",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Salas por estado",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "targets": [
        { "expr": "sum by (game, status) (naipe_real_rooms)", "legendFormat": "{{game}} · {{status}}" }
      ]
    },
    {
      "id": 2,
      "title": "Conexões",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "targets": [
        { "expr": "naipe_real_connections", "legendFormat": "conexões" }
      ]
    },
    {
      "id": 3,
      "title": "Comandos por segundo",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "targets": [
        { "expr": "sum by (outcome) (rate(naipe_real_commands_total[1m]))", "legendFormat": "{{outcome}}" }
      ]
    },
    {
      "id": 4,
      "title": "Duração de comando p95 (s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, command) (rate(naipe_real_command_duration_seconds_bucket[1m])))", "legendFormat": "{{command}}" }
      ]
    },
    {
      "id": 5,
      "title": "Duração de broadcast p95 (s)",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(naipe_real_broadcast_duration_seconds_bucket[1m])))", "legendFormat": "broadcast" }
      ]
    },
    {
      "id": 6,
      "title": "Atraso do event loop p99 (s)",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "nodejs_eventloop_lag_p99_seconds", "legendFormat": "p99" }
      ]
    },
    {
      "id": 7,
      "title": "CPU (núcleos)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(process_cpu_seconds_total[1m])", "legendFormat": "cpu" }
      ]
    },
    {
      "id": 8,
      "title": "Memória",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        { "expr": "process_resident_memory_bytes", "legendFormat": "rss" },
        { "expr": "nodejs_heap_size_used_bytes", "legendFormat": "heap" }
      ]
    }
  ]
}
